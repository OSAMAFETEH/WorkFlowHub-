@model WorkFlowHub.Application.Common.PagedResult<
    WorkFlowHub.Application.DTOs.Employees.EmployeeDto>

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<form method="get" class="mb-4">

    <input type="text"
           name="Search"
           placeholder="Search..."
           class="form-control mb-2" />

    <select name="SortBy"
            class="form-select mb-2">

        <option value="">Name</option>
        <option value="email">Email</option>
        <option value="hiredate">Hire Date</option>

    </select>

    <button type="submit"
            class="btn btn-primary">
        Search
    </button>

</form>

<table class="table">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Hire Date</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var employee in Model.Items)
        {
            <tr>
                <td>@employee.FullName</td>
                <td>@employee.Email</td>
                <td>@employee.DepartmentName</td>
                <td>@employee.HireDate.ToShortDateString()</td>
            </tr>
        }

    </tbody>

</table>

<div class="mt-3">

    @for (var page = 1;
          page <= Model.TotalPages;
          page++)
    {
        <a asp-action="Index"
           asp-route-page="@Model.Page"
           asp-route-pageSize="@Model.PageSize"
           class="btn btn-sm
                  @(page == Model.Page
                      ? "btn-primary"
                      : "btn-outline-primary")">

            @Model.Page

        </a>
    }

</div>