@model List<DepartmentDto>

@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

<a asp-action="Create" class="btn btn-primary">
    Create Department
</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Description</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.Id</td>
                <td>@department.Name</td>
                <td>@department.Description</td>
                <td>@department.CreatedAt.ToLocalTime()</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@department.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>